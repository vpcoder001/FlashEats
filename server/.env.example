# Server Port (use 5001 to avoid conflict with macOS AirPlay Receiver on port 5000)
PORT=5001

# MongoDB Connection String (Required)
# Local: mongodb://localhost:27017/flasheats
# Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/flasheats?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/flasheats

# JWT Secret Key for token signing and verification (Required)
JWT_SECRET=your_jwt_secret_key_here

# Google OAuth Client ID (Required for Google Sign-In)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# SendGrid API Key for sending OTP emails to admins (Must start with SG.)
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here

# SendGrid Sender Email Address (Verified sender in SendGrid)
EMAIL_FROM=noreply@example.com
